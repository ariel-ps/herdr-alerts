#!/usr/bin/env zsh
# Use the same playback and configuration as the status-alert hook.
emulate -L zsh
if (( $# > 1 )); then
  print -u2 'usage: alert8play [NAME | --list | --help]'
  exit 2
fi
case "${1:-}" in
  -h|--help)
    print 'usage: alert8play [NAME | --list | --help]'
    print 'Compatibility command for herdr-sound play. See herdr-sound --help.'
    ;;
  --list) exec "${0:A:h}/herdr-sound" list ;;
  -*) print -u2 "alert8play: unknown option: $1"; exit 2 ;;
  *) exec "${0:A:h}/herdr-sound" play "$@" ;;
esac
