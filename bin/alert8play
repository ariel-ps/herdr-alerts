#!/usr/bin/env zsh
# Use the same playback and configuration as the status-alert hook.
emulate -L zsh
export HERDR_PLUGIN_ROOT="${0:A:h:h}"
if (( $# > 1 )); then
  print -u2 'usage: alert8play [NAME | --list | --help]'
  exit 2
fi
case "${1:-}" in
  -h|--help)
    print 'usage: alert8play [NAME | --list | --help]'
    print 'No name plays the bundled sound. Download game sounds with herdr-sounds-sync.'
    ;;
  --list) exec zsh "$HERDR_PLUGIN_ROOT/alert-hook.sh" --list ;;
  -*) print -u2 "alert8play: unknown option: $1"; exit 2 ;;
  *) exec zsh "$HERDR_PLUGIN_ROOT/alert-hook.sh" --play "$@" ;;
esac
