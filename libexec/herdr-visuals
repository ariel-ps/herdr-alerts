#!/usr/bin/env zsh
# Shared visual effects for manual previews and automatic pane alerts.
emulate -L zsh
setopt pipefail extendedglob
root="${HERDR_PLUGIN_ROOT:-${0:A:h:h}}"
pane=${1:-}
state=${2:-preview}
name=${3:-}
flash=${4:-1}
sprite=${5:-1}
if [[ $# -gt 5 || "$pane" == *[^a-zA-Z0-9_:-]* || ( "$state" != preview && "$state" != blocked && "$state" != done ) ]]; then
  print -u2 -- 'herdr-alert: visuals require a valid pane ID and preview, blocked, or done state.'
  exit 2
fi

result=0
if [[ "$flash" == 1 ]]; then
  flash_state=$state
  [[ "$state" == preview ]] && flash_state=done
  zsh "$root/libexec/herdr-flash" "$pane" "$flash_state" || result=$?
fi
[[ "$sprite" == 1 && "$state" != done ]] || exit "$result"

terminal=/dev/tty
if [[ -n "$pane" ]]; then
  shell_pid=$("${HERDR_BIN_PATH:-herdr}" pane process-info --pane "$pane" | jq -er '.result.process_info.shell_pid | select(type == "number")') || exit 1
  [[ "$shell_pid" == <1-> ]] || exit 1
  tty=$(ps -o tty= -p "$shell_pid" | tr -d ' ') || exit 1
  if [[ ( "$tty" != tty[a-zA-Z0-9]## && "$tty" != pts/<-> ) || ! -c "/dev/$tty" ]]; then
    print -u2 -- 'herdr-alert: no terminal found for the Herdr pane.'
    exit 1
  fi
  terminal="/dev/$tty"
fi
size=($(stty size < "$terminal" 2>/dev/null))
rows=${size[1]:-}
cols=${size[2]:-}
if [[ "$cols" != <1-> ]]; then
  print -u2 -- 'herdr-alert: sprites need an interactive terminal; use set sprite off for audio-only jobs.'
  exit 1
fi
[[ "$rows" == <1-> ]] && export SPRITE_ROWS="$rows"

export SPRITE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/herdr-kit/sprites"
export SPRITE_PANE_ID="$pane"

# A caller-supplied game+sprite pair (e.g. `set blocked-sprite`) wins, but only
# if it is actually downloaded; an override pointing at a pack nobody fetched
# yet degrades to the sound alert's own sprite rather than drawing nothing.
if [[ -n "${SPRITE_GAME:-}" && -n "${SPRITE_NAME:-}" ]] \
   && ! [[ -r "$SPRITE_DIR/$SPRITE_GAME/$SPRITE_NAME.rgba" ]]; then
  unset SPRITE_GAME SPRITE_NAME
fi

# The imported custom scene (set by the caller only when that event's sprite
# selection is literally "custom" -- see the hook script) degrades the same
# way: a selection pointing at a scene that got deleted falls through to the
# catalog sprite logic below instead of drawing nothing.
if [[ -n "${SPRITE_FILE:-}" ]] && ! [[ -r "$SPRITE_FILE" ]]; then
  unset SPRITE_FILE SPRITE_FULLSCREEN
fi

[[ -r "$root/generated/alerts.zsh" ]] && source "$root/generated/alerts.zsh"
if typeset -f __herdr_alert_spec >/dev/null && __herdr_alert_spec "$name"; then
  [[ -z "${SPRITE_GAME:-}" && -z "${SPRITE_FILE:-}" ]] && export SPRITE_GAME="$alert_game"
  [[ -z "${SPRITE_NAME:-}" && -z "${SPRITE_FILE:-}" && -n "$alert_sprite" \
     && -r "$SPRITE_DIR/$alert_game/$alert_sprite.rgba" ]] && export SPRITE_NAME="$alert_sprite"
fi
perl "$root/vendor/sprite/sprite.pl" "$terminal" "$cols" || exit $?
exit "$result"
