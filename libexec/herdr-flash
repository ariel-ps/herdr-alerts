#!/usr/bin/env zsh
# Use the original flash-term background effect outside Herdr, and the same
# Kitty image protocol as vendor/sprite/sprite.pl inside a Herdr pane.
emulate -L zsh
setopt pipefail extendedglob

pane=${1:-}
state=${2:-done}
if [[ $# -gt 2 || "$pane" == *[^a-zA-Z0-9_:-]* || ( "$state" != done && "$state" != blocked ) ]]; then
  print -u2 -- 'herdr-sound: flash requires a valid pane ID and done or blocked state.'
  exit 2
fi

terminal=/dev/tty
if [[ -n "$pane" ]]; then
  shell_pid=$(herdr pane process-info --pane "$pane" | jq -er '.result.process_info.shell_pid | select(type == "number")') || exit 1
  [[ "$shell_pid" == <1-> ]] || exit 1
  terminal=$(ps -o tty= -p "$shell_pid" | tr -d ' ') || exit 1
  if [[ ( "$terminal" != tty[a-zA-Z0-9]## && "$terminal" != pts/<-> ) || ! -c "/dev/$terminal" ]]; then
    print -u2 -- 'herdr-sound: no terminal found for the Herdr pane.'
    exit 1
  fi
  terminal="/dev/$terminal"
fi
if ! { exec 3>"$terminal"; } 2>/dev/null; then
  print -u2 -- 'herdr-sound: --flash needs an interactive terminal; omit it for audio-only jobs.'
  exit 1
fi

color='#00cc44'
[[ "$state" == blocked ]] && color='#ff0000'
if [[ -n "$pane" ]]; then
  # OSC background changes and tput flash are ignored by Herdr 0.9.3. Its
  # supported Kitty image path draws above even a full-screen agent instead.
  read -r rows cols <<<"$(stty size < "$terminal")"
  if [[ "$rows" != <1-> || "$cols" != <1-> ]]; then
    print -u2 -- 'herdr-sound: cannot determine the pane dimensions.'
    exit 1
  fi
  rgba=(0 204 68 255)
  [[ "$state" == blocked ]] && rgba=(255 0 0 255)
  pixels=$(perl -MMIME::Base64 -e 'print encode_base64(pack("C4", @ARGV) x 64, "")' "${rgba[@]}") || exit 1
  printf -v flash '\0337\033[H\033_Ga=T,f=32,s=8,v=8,c=%s,r=%s,C=1,z=9,i=%s,q=2;%s\033\\\0338' "$cols" "$rows" "$$" "$pixels"
  printf -v restore '\033_Ga=d,d=I,i=%s,q=2\033\\' "$$"
else
  # Keep the original Kitty color restoration; reset to the terminal's default
  # background elsewhere, exactly as flash-term does.
  restore=$'\e]111\e\\'
  if [[ -n "${KITTY_WINDOW_ID:-}" ]] && command -v kitty >/dev/null 2>&1; then
    background=$(kitty @ get-colors --match "id:$KITTY_WINDOW_ID" 2>/dev/null | awk '$1 == "background" { print $2; exit }')
    [[ "$background" == \#[0-9a-fA-F](#c6) ]] && restore=$'\e]11;'"$background"$'\e\\'
  fi
  printf -v flash '\033]11;%s\033\\' "$color"
fi

trap 'printf "%s" "$restore" >&3' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
for _ in 1 2 3 4; do
  printf '%s' "$flash" >&3
  sleep 0.13
  printf '%s' "$restore" >&3
  sleep 0.13
done
